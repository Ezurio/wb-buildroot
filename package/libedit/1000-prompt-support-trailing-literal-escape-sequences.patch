-	n += ct_encode_char(b + n, (size_t)(w - n), end[1]);
-	b[n] = '\0';
-
-	/*
-	 * Then save this literal string in the list of such strings,
-	 * and return a "magic character" to put into the terminal buffer.
-	 * When that magic char is 'printed' the saved string (which includes
-	 * the char that belongs in that position) gets sent instead.
-	 */
-	if (l->l_idx == l->l_len) {
-		char **bp;
-
-		l->l_len += 4;
-		bp = el_realloc(l->l_buf, sizeof(*l->l_buf) * l->l_len);
-		if (bp == NULL) {
-			free(b);
-			l->l_len -= 4;
-			return 0;
-		}
-		l->l_buf = bp;
-	}
-	l->l_buf[l->l_idx++] = b;
-	return EL_LITERAL | (wint_t)(l->l_idx - 1);
+	return literal_create(l, end[1], 0, buf, end);
 }
 
 libedit_private const char *
@@ -141,3 +164,57 @@
 	assert(l->l_idx > (size_t)idx);
 	return l->l_buf[idx];
 }
+
+/*
+ * literal_append():
+ *	Append a trailing literal sequence to the preceding character cell in
+ *	the virtual display buffer so trailing escapes (e.g. COLOR_OFF) are not
+ *	lost when there is no subsequent visible character.
+ */
+libedit_private void
+literal_append(EditLine *el, const wchar_t *buf, const wchar_t *end)
+{
+	el_literal_t *l = &el->el_literal;
+	coord_t *cur = &el->el_refresh.r_cursor;
+	int v = cur->v, h = cur->h - 1;
+	size_t extra_len;
+	wint_t c, lit;
+
+	/* Find preceding character cell (wrapping to previous row(s) if needed) */
+	while (h < 0 && v > 0) {
+		v--;
+		h = (int)wcslen((const wchar_t *)el->el_vdisplay[v]) - 1;
+	}
+
+	if (h < 0) {
+		/* No preceding character in entire prompt display: store at (0, 0) */
+		lit = literal_create(l, 0, 0, buf, end);
+		if (lit != 0)
+			el->el_vdisplay[0][0] = lit;
+		return;
+	}
+
+	while (h > 0 && el->el_vdisplay[v][h] == MB_FILL_CHAR)
+		h--;
+
+	extra_len = literal_encoded_len(buf, end);
+	c = el->el_vdisplay[v][h];
+
+	if (c & EL_LITERAL) {
+		/* Preceding cell is already a literal: append to its buffer */
+		size_t idx = c & ~EL_LITERAL;
+		size_t old_len = strlen(l->l_buf[idx]);
+		char *b = el_realloc(l->l_buf[idx], old_len + extra_len + 1);
+
+		if (b == NULL)
+			return;
+		l->l_buf[idx] = b;
+		old_len += literal_encode(b + old_len, extra_len + 1, buf, end);
+		b[old_len] = '\0';
+	} else {
+		/* Preceding cell is a normal character: promote it to a literal */
+		lit = literal_create(l, (wchar_t)c, 1, buf, end);
+		if (lit != 0)
+			el->el_vdisplay[v][h] = lit;
+	}
+}
diff -ruN a/src/literal.h b/src/literal.h
