From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
Date: Thu, 17 Sep 2026 00:00:00 +0000
Subject: [PATCH] prompt: support trailing literal escape sequences

In prompt_print(), when a literal escape sequence occurs at the very end
of the prompt (!p[1]), libedit previously discarded it with
"// XXX: We lose the last literal" and broke out of the loop.

This breaks prompts whose trailing sequence is a terminal reset code like
SGR 0 (\033[0m) to reset prompt attributes. Dropping the closing escape
sequence leaves the terminal in the active attribute/color mode, causing
subsequent output to inherit the prompt's styling.

Implement literal_append() to attach the trailing literal sequence to
the preceding character cell in the virtual display buffer, ensuring the
terminal escape sequence is output.

Signed-off-by: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
Upstream-Status: Pending
diff -ruN a/src/literal.c b/src/literal.c
--- a/src/literal.c	2026-05-08 15:38:20.000000000 -0400
+++ b/src/literal.c	2026-09-17 20:42:25.239441298 -0400
@@ -50,6 +50,67 @@
 #include <string.h>
 #include "el.h"
 
+static size_t
+literal_encoded_len(const wchar_t *buf, const wchar_t *end)
+{
+	size_t w = 0;
+	while (buf < end)
+		w += (size_t)ct_enc_width(*buf++);
+	return w;
+}
+
+static size_t
+literal_encode(char *dst, size_t max, const wchar_t *buf, const wchar_t *end)
+{
+	size_t n = 0;
+	while (buf < end)
+		n += (size_t)ct_encode_char(dst + n, max - n, *buf++);
+	return n;
+}
+
+static wint_t
+literal_store(el_literal_t *l, char *b)
+{
+	if (l->l_idx == l->l_len) {
+		char **bp;
+
+		l->l_len += 4;
+		bp = el_realloc(l->l_buf, sizeof(*l->l_buf) * l->l_len);
+		if (bp == NULL) {
+			free(b);
+			l->l_len -= 4;
+			return 0;
+		}
+		l->l_buf = bp;
+	}
+	l->l_buf[l->l_idx++] = b;
+	return EL_LITERAL | (wint_t)(l->l_idx - 1);
+}
+
+static wint_t
+literal_create(el_literal_t *l, wchar_t c, int post,
+    const wchar_t *buf, const wchar_t *end)
+{
+	size_t char_len = c ? (size_t)ct_enc_width(c) : 0;
+	size_t extra_len = literal_encoded_len(buf, end);
+	char *b = el_malloc(char_len + extra_len + 1);
+	size_t n = 0;
+
+	if (b == NULL)
+		return 0;
+
+	if (post && c) {
+		n += (size_t)ct_encode_char(b, char_len + 1, c);
+		n += literal_encode(b + n, extra_len + 1, buf, end);
+	} else {
+		n += literal_encode(b, extra_len + 1, buf, end);
+		if (c)
+			n += (size_t)ct_encode_char(b + n, char_len + 1, c);
+	}
+	b[n] = '\0';
+	return literal_store(l, b);
+}
+
 libedit_private void
 literal_init(EditLine *el)
 {
@@ -85,50 +146,12 @@
 literal_add(EditLine *el, const wchar_t *buf, const wchar_t *end, int *wp)
 {
 	el_literal_t *l = &el->el_literal;
-	size_t i, len;
-	ssize_t w, n;
-	char *b;
-
-	w = wcwidth(end[1]);	/* column width of the visible char */
-	*wp = (int)w;
 
-	if (w < 0)		/* non-printable characters are negative */
+	*wp = wcwidth(end[1]);	/* column width of the visible char */
+	if (*wp < 0)		/* non-printable characters are negative */
 		return 0;
 
-	len = (size_t)(end - buf);
-	for (w = 0, i = 0; i < len; i++)
-		w += ct_enc_width(buf[i]);
-	w += ct_enc_width(end[1]);
-
-	b = el_malloc((size_t)(w + 1));
-	if (b == NULL)
-		return 0;
-
-	for (n = 0, i = 0; i < len; i++)
