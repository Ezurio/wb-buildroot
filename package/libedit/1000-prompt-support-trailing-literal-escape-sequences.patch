@@ -49,5 +49,7 @@
 libedit_private wint_t literal_add(EditLine *, const wchar_t *,
     const wchar_t *, int *);
 libedit_private const char *literal_get(EditLine *, wint_t);
+libedit_private void literal_append(EditLine *, const wchar_t *,
+    const wchar_t *);
 
 #endif /* _h_el_literal */
diff -ruN a/src/prompt.c b/src/prompt.c
