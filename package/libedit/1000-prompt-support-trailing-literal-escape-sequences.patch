@@ -101,8 +101,10 @@
 			wchar_t *litstart = ++p;
 			while (*p && *p != elp->p_ignore)
 				p++;
-			if (!*p || !p[1]) {
-				// XXX: We lose the last literal
+			if (!*p)
+				break;
+			if (!p[1]) {
+				literal_append(el, litstart, p);
 				break;
 			}
 			re_putliteral(el, litstart, p++);
