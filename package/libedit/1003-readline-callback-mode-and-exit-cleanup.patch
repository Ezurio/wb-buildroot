From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
Date: Thu, 17 Sep 2026 00:00:00 +0000
Subject: [PATCH] readline: fix callback mode handling and exit cleanup

Fix several compatibility issues in the readline callback mode:

1. rl_callback_read_char:
   - Ensure EL_UNBUFFERED is active before calling el_gets().
   - Do not disable EL_UNBUFFERED on line accept. Disabling it called
     tty_cookedmode(), reverting the terminal to cooked mode where the
     kernel tty echoed Backspace as literal "^H" instead of libedit
     handling it.
   - On line accept, clear line buffer with ch_reset(e) before invoking
     the callback function, and refresh the prompt for the next command if
     rl_linefunc is still installed.

2. rl_callback_handler_remove and rl_message:
   - When rl_message() is called with an empty string, clear the visible
     line. In rl_callback_handler_remove(), clear the visible line and
     call rl_deprep_terminal() so the prompt does not remain on screen
     when exiting to the calling shell.

3. rl_replace_line:
   - When passed an empty string or NULL, clear the line buffer
     (reset cursor/lastchar and NUL-terminate) and update positions.

4. rl_copy_text:
   - Pass len + 1 to strlcpy() so the final character is not truncated.

Signed-off-by: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
Upstream-Status: Pending
--- a/src/readline.c	2026-09-17 20:09:00.505181322 -0400
+++ b/src/readline.c	2026-09-17 20:08:54.398293798 -0400
@@ -291,7 +291,9 @@
 void
 rl_save_prompt(void)
 {
-	rl_prompt_saved = strdup(rl_prompt);
+	if (rl_prompt_saved)
+		el_free(rl_prompt_saved);
+	rl_prompt_saved = rl_prompt ? strdup(rl_prompt) : NULL;
 }
 
 void
@@ -299,6 +301,8 @@
 {
 	if (!rl_prompt_saved)
 		return;
+	if (rl_prompt)
+		el_free(rl_prompt);
 	rl_prompt = rl_prompt_saved;
 	rl_prompt_saved = NULL;
 }
@@ -2134,10 +2138,16 @@
 rl_callback_read_char(void)
 {
 	int count = 0, done = 0;
-	const char *buf = el_gets(e, &count);
+	const char *buf;
 	char *wbuf;
 
-	el_set(e, EL_UNBUFFERED, 1);
+	if (e == NULL)
+		rl_initialize();
+
+	if ((e->el_flags & UNBUFFERED) == 0)
+		el_set(e, EL_UNBUFFERED, 1);
+
+	buf = el_gets(e, &count);
 	if (buf == NULL || count-- <= 0)
 		return;
 	if (count == 0 && buf[0] == e->el_tty.t_c[TS_IO][C_EOF])
@@ -2146,14 +2156,22 @@
 		done = 2;
 
 	if (done && rl_linefunc != NULL) {
-		el_set(e, EL_UNBUFFERED, 0);
 		if (done == 2) {
 			if ((wbuf = strdup(buf)) != NULL)
 				wbuf[count] = '\0';
 			RL_SETSTATE(RL_STATE_DONE);
 		} else
 			wbuf = NULL;
+		ch_reset(e);
+		re_clear_display(e);
+		_rl_update_pos();
 		(*(void (*)(const char *))rl_linefunc)(wbuf);
+		RL_UNSETSTATE(RL_STATE_DONE);
+		if (rl_linefunc != NULL) {
+			re_clear_display(e);
+			re_refresh(e);
+			terminal__flush(e);
+		}
 	}
 	_rl_update_pos();
 }
@@ -2172,6 +2190,10 @@
 void
 rl_callback_handler_remove(void)
 {
+	if (e == NULL)
+		return;
+	rl_clear_visible_line();
+	rl_deprep_terminal();
 	el_set(e, EL_UNBUFFERED, 0);
 	rl_linefunc = NULL;
 }
@@ -2330,7 +2352,7 @@
 	out = el_malloc((size_t)len + 1);
 	if (out == NULL)
 		return NULL;
-	(void)strlcpy(out, li->buffer + from , len);
+	(void)strlcpy(out, li->buffer + from , len + 1);
 
 	return out;
 }
@@ -2338,13 +2360,19 @@
 void
 rl_replace_line(const char * text, int clear_undo __attribute__((__unused__)))
 {
-	if (!text || *text == 0)
-		return;
-
 	if (h == NULL || e == NULL)
 		rl_initialize();
 
+	if (!text || *text == 0) {
+		e->el_line.cursor = e->el_line.buffer;
+		e->el_line.lastchar = e->el_line.buffer;
+		e->el_line.buffer[0] = '\0';
+		_rl_update_pos();
+		return;
+	}
+
 	el_replacestr(e, text);
+	_rl_update_pos();
 }
 
 int
@@ -2377,6 +2405,11 @@
 	vsnprintf(msg, sizeof(msg), format, args);
 	va_end(args);
 
+	if (msg[0] == '\0') {
+		rl_clear_visible_line();
+		return;
+	}
+
 	rl_set_prompt(msg);
 	rl_forced_update_display();
 }
