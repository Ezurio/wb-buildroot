diff -ruN a/configure.ac b/configure.ac
--- a/configure.ac	2026-09-17 17:49:23.363681979 -0400
+++ b/configure.ac	2026-09-17 16:21:42.512280804 -0400
@@ -340,8 +340,39 @@
 AM_CONDITIONAL(CLIENT, test "${enable_client}" != "no")
 
 if (test "${enable_client}" != "no" || test "${enable_mesh}" = "yes"); then
-        AC_CHECK_HEADERS(readline/readline.h, enable_readline=yes,
-                AC_MSG_ERROR(readline header files are required))
+        AC_ARG_WITH([readline],
+                AS_HELP_STRING([--with-readline=BACKEND],
+                        [use auto, readline, or libedit (default: auto)]),
+                [readline_backend=${withval}], [readline_backend=auto])
+
+        case "${readline_backend}" in
+        auto|readline|libedit) ;;
+        *) AC_MSG_ERROR([invalid readline backend: ${readline_backend}]) ;;
+        esac
+
+        if test "${readline_backend}" = "readline" ||
+                test "${readline_backend}" = "auto"; then
+                AC_CHECK_HEADERS([readline/readline.h], [
+                        AC_CHECK_LIB([readline], [readline], [
+                                READLINE_LIBS=-lreadline
+                                enable_readline=yes
+                                AC_DEFINE([HAVE_READLINE_BACKEND], [1],
+                                        [Define if GNU readline is used])
+                        ], [readline_backend=libedit])
+                ], [readline_backend=libedit])
+        fi
+
+        if test "${readline_backend}" = "libedit"; then
+                AC_CHECK_HEADERS([editline/readline.h], [
+                        AC_CHECK_LIB([edit], [readline], [
+                                READLINE_LIBS=-ledit
+                                enable_readline=yes
+                                AC_DEFINE([HAVE_LIBEDIT_BACKEND], [1],
+                                        [Define if libedit is used])
+                        ], [AC_MSG_ERROR([libedit library is required])])
+                ], [AC_MSG_ERROR([libedit headers are required])])
+        fi
+        AC_SUBST([READLINE_LIBS])
 fi
 AM_CONDITIONAL(READLINE, test "${enable_readline}" = "yes")
 
