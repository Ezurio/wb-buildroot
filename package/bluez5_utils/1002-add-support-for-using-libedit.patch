 tools/mesh-gatt/onoff-model.c |  6 ++++++
 tools/mesh-gatt/prov.c        |  5 +++++
 tools/obex-client-tool.c      |  4 ++++
 9 files changed, 78 insertions(+), 10 deletions(-)

